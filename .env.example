# !! DO NOT PUT YOUR REAL KEY IN THIS FILE !!
# This file is uploaded to GitHub on purpose, so it must stay blank. Copy it to
# a new file named .env.local and put your key there instead; .env.local is
# never uploaded. A key found in a public repo is disabled by Google within minutes.
#
# Get a free key at https://aistudio.google.com/apikey (no billing needed).
GEMINI_API_KEY=

# Free-tier quotas are PER MODEL and the newest model is the tightest, so use a
# mid-size model first and a lighter one as backup. The backup is only used when
# the first is out of quota or overloaded. Names change: confirm in AI Studio
# (or list them: GET https://generativelanguage.googleapis.com/v1beta/models).
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# 0 is the most deterministic. If outputs look odd or repetitive on a newer
# Gemini model, try 1 (Google's recommended default for Gemini 3).
GEMINI_TEMPERATURE=0

# Set to 1 to run the UI with a fake offline model (takes the first 8 words).
# For trying the interface without a key only. NOT a real summariser.
MOCK_LLM=0
